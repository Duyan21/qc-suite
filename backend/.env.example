DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SECRET_KEY=your-secret-key
GEMINI_API_KEY=your-gemini-api-key

# Password-reset emails. If SMTP_HOST is unset, the reset link is
# printed to the console instead of sent (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@qcsuite.local
FRONTEND_URL=http://localhost:5173