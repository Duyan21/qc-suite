DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SECRET_KEY=your-secret-key
GEMINI_API_KEY=your-gemini-api-key
# Email of the account that should always hold is_superadmin, reconciled on
# every backend startup. Without this, superadmin status only ever exists on
# whichever user happened to register first, with no recovery if that
# account is deleted or the DB is reseeded.
SUPERADMIN_EMAIL=you@example.com