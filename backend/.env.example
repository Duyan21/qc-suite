DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SECRET_KEY=your-secret-key
GEMINI_API_KEY=your-gemini-api-key
# Email of the account that should always hold is_superadmin, reconciled on
# every backend startup. Without this, superadmin status only ever exists on
# whichever user happened to register first, with no recovery if that
# account is deleted or the DB is reseeded.
SUPERADMIN_EMAIL=you@example.com
# Verification / password-reset emails. If SMTP_HOST is unset, the link is
# printed to the console instead of sent (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@qcsuite.local
FRONTEND_URL=http://localhost:5173
# Must be explicitly enabled (true/1/yes) to print verification/reset links to
# the console when SMTP_HOST is unset. Intended for local dev only — leaving
# this unset in production means a misconfigured SMTP_HOST fails loudly (via
# logs) instead of silently locking out every new user.
EMAIL_CONSOLE_FALLBACK=true
